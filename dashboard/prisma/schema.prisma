generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  user
}

enum CommandStatus {
  pending
  success
  error
}

model User {
  id          String     @id @default(cuid())
  discordId   String     @unique
  username    String
  avatar      String?
  role        UserRole   @default(user)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  logs        Log[]
  items       Item[]
  commands    Command[]  @relation("ExecutedCommands")
  accounts    Account[]
  sessions    Session[]
}

model Log {
  id        String   @id @default(cuid())
  userId    String
  action    String
  metadata  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action])
}

model Item {
  id          String   @id @default(cuid())
  userId      String
  name        String
  quantity    Int      @default(1)
  status      String   @default("sent")
  deliveredAt DateTime @default(now())
  metadata    String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deliveredAt])
}

model Command {
  id         String        @id @default(cuid())
  executedBy String
  command    String
  status     CommandStatus @default(pending)
  result     String?
  createdAt  DateTime      @default(now())
  executor   User          @relation("ExecutedCommands", fields: [executedBy], references: [id], onDelete: Cascade)

  @@index([executedBy, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
