# Copie para dashboard/.env
# IMPORTANTE: use o MESMO banco já usado pelo bot.
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:../database.db"

APP_NAME="Bot da Guild Dashboard"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere-uma-secret-forte"

DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
ADMIN_DISCORD_IDS=""

# Healthcheck do bot (opcional, só para mostrar status no painel)
BOT_API_BASE_URL="http://127.0.0.1:10000"
BOT_STATUS_ENDPOINT="/health"
BOT_API_TIMEOUT_MS=10000

# Bridge de comandos é OPCIONAL.
# Deixe vazio se o seu bot não expõe endpoint HTTP de comando.
BOT_COMMAND_ENDPOINT=""
