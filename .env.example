# Copie para .env e preencha os IDs/tokens reais.
# Se você já tem um banco em uso pelo bot atual, aponte DATABASE_URL/SQLITE_PATH para ele.

DISCORD_TOKEN=
GUILD_ID=0
LOG_LEVEL=INFO

# Banco de dados
# Opção 1: PostgreSQL já existente
DATABASE_URL=
# Opção 2: SQLite já existente (use junto com DATABASE_URL vazio)
SQLITE_PATH=./database.db
DEFAULT_GUILD_ID=0
SAAS_DEFAULT_PLAN=pro

# Canais / cargos do Discord
STAFF_ROLE_ID=0
CATEGORY_ID=0
ANNOUNCEMENTS_CHANNEL_ID=0
FORUM_CHANNEL_ID=0
FORUM_TAG_ID=0
G3X_ROLE_ID=0
STAFF_CHANNEL_ID=0
ITEM_REQUEST_SUMMARY_CHANNEL_ID=0
DELIVERY_LOG_CHANNEL_ID=0
EXTRAORDINARY_STAFF_CHANNEL_ID=0
EXTRAORDINARY_STAFF_WEBHOOK_URL=

# Healthcheck HTTP do bot (opcional, usado pelo dashboard para status)
HEALTH_HOST=0.0.0.0
PORT=10000

# Recursos opcionais
FORUM_ANNOUNCE_TEST_MODE=false
IMAGE_STORAGE_PROVIDER=local
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
